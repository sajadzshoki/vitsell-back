# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
FRONTEND_URL=http://localhost:3000

# Session
SESSION_DRIVER=cookie

# Postgres
# Local Docker Compose maps host 5433 → container 5432 (host 5432 often taken by Windows Postgres).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=digishop
DB_PASSWORD=digishop
DB_DATABASE=digishop

# Kavenegar (OTP)
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=digishop-verify
# Dev only: mock OTP when API key missing. Never true in production.
ALLOW_OTP_MOCK=true

# Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3333/api/v1/payments/zarinpal/callback
# Dev only: mock payment when merchant missing. Never true in production.
ALLOW_PAYMENT_MOCK=true