# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
FRONTEND_URL=http://localhost:4000
# Admin panel origin (separate domain). Leave empty in local store-only; set for admin auth lock.
ADMIN_URL=http://localhost:4001
# Returned by GET /health (and GET /). Bump on each deploy for health checkers.
APP_VERSION=beta.0.1

# Production (vitsell) — ADMIN_URL باید دقیقاً origin پنل ادمین باشد (با/بدون https، بدون / انتهایی)
# FRONTEND_URL=https://vitsell.ir
# ADMIN_URL=https://seller.vitsell.ir
# APP_URL=https://api.vitsell.ir
#
# Staging (vistatest):
# FRONTEND_URL=https://digishop.vistatest.top
# ADMIN_URL=https://digishop-admin.vistatest.top
# APP_URL=https://digishop-back.vistatest.top

# Session
SESSION_DRIVER=cookie

# Drive / MinIO (S3-compatible) — bucket: vitsell
# Console UI: http://127.0.0.1:9001  (user/pass = AWS_* below)
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=vitsell
AWS_SECRET_ACCESS_KEY=vitsellsecret
AWS_REGION=ir-thr-1
S3_BUCKET=vitsell
# Host app → localhost; API container → http://minio:9000
S3_ENDPOINT=http://127.0.0.1:9000
# Public object base (path-style). Leave empty to serve via GET /uploads/:file
S3_PUBLIC_URL=http://127.0.0.1:9000/vitsell

# Postgres
# Local Docker Compose maps host 15432 → container 5432
# (Windows often reserves 5433–5532 via Hyper-V; host 5432 may also be taken.)
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=vitsell
DB_PASSWORD=vitsell
DB_DATABASE=vitsell

# Kavenegar
# OTP still uses verify/lookup (KAVENEGAR_OTP_TEMPLATE).
# Order SMS is plain text via sms/send — no lookup template. Set the line number.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=vitsell-verify
KAVENEGAR_SENDER=
# Dev only: mock OTP/order SMS when API key missing. Never true in production.
ALLOW_OTP_MOCK=true

# Zarinpal
# Sandbox: any 36-char merchant id + ZARINPAL_SANDBOX=true → sandbox.zarinpal.com
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3333/api/v1/payments/zarinpal/callback
# Production: set to public API callback, e.g. https://api.vitsell.ir/api/v1/payments/zarinpal/callback
# (loopback callback_url is ignored when APP_URL is public)
# After payment the API redirects to FRONTEND_URL (or the shopper's returnOrigin).
# On the server FRONTEND_URL MUST be the public storefront — not localhost.
# Optional extra allowlist: PAYMENT_RETURN_ORIGINS=https://a.com,https://b.com
PAYMENT_RETURN_ORIGINS=
# Dev only: mock payment when merchant missing. Never true in production.
ALLOW_PAYMENT_MOCK=true

# Docker entrypoint: run `node ace db:seed` on start. Leave false/unset in production.
# RUN_DB_SEED=false

# Technolife product importer (optional; defaults in config/technolife.ts)
TECHNOLIFE_ENABLED=true
TECHNOLIFE_REQUEST_DELAY_MS=1500
TECHNOLIFE_TIMEOUT_MS=15000
TECHNOLIFE_MAX_RETRIES=3
TECHNOLIFE_CONCURRENCY=1
TECHNOLIFE_MAX_IMAGES=20
TECHNOLIFE_DEFAULT_STOCK=10
TECHNOLIFE_DEFAULT_CATEGORY_ID=mobile
TECHNOLIFE_DEFAULT_CATEGORY_URL=https://www.technolife.com/category/mobile/mobile-phone
TECHNOLIFE_MAX_CATEGORY_IMPORT=2000
TECHNOLIFE_UPDATE_PRICE=false
TECHNOLIFE_UPDATE_INVENTORY=false
TECHNOLIFE_UPDATE_DESCRIPTION=true
TECHNOLIFE_UPDATE_IMAGES=true
TECHNOLIFE_UPDATE_SPECS=true
# Strip Techno Life corner watermark on download (default true)
TECHNOLIFE_STRIP_LOGO=true
# Always paint logo box even when detection is weak (may clip phone corners)
TECHNOLIFE_STRIP_LOGO_FORCE=false
